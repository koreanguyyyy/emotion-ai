# ── 1학기 emotion-detection과 같은 설정 ──
AI_SERVER_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080
USER_ID=1
DETECTION_INTERVAL=5        # 스트레스 판단 주기 (초)
STT_MODE=fixed              # fixed: 고정 길이 / vad: 말소리 감지
STT_DURATION=10
VAD_SILENCE_SEC=1.5
COOLDOWN_MINUTES=30
TTS_ENABLED=true
TTS_VOICE=Yuna
TTS_RATE=180

# ── fusion 버전에서 추가된 설정 ──
CAMERA_INDEX=0
FACE_MODEL_PATH=models/face_landmarker.task
STT_ENABLED=true
STRESS_THRESHOLD=6
BASELINE_SEC=60
RESTING_HR=
HR_QUALITY_MIN=0.40         # CHROM·POS 중 높은 쪽 품질 기준 (잡음 시험 통과 0%)
HR_CALIB_TIMEOUT_SEC=120     # 이 시간 안에 심박 보정이 안 되면 표정만으로 동작
HR_HOLD_SEC=5
RPPG_WINDOW_SEC=20

# ── 스트레스 지수 가중치·기준값 (초기값, 보정 대상) ──
STRESS_W_NEG=0.35           # 부정 정서 비중
STRESS_W_HR=0.35            # 심박 상승(평상시 대비) 비중
STRESS_W_AROUSAL=0.10       # 표정 각성 비중
STRESS_W_INSTAB=0.2         # 감정 기복(MSSD) 비중
STRESS_VALENCE_REF=0.4      # 정서가 평균 -0.4 → 부정 정서 정도 최대
STRESS_AROUSAL_REF=0.5      # 표정 각성도 평균 +0.5 → 표정 각성 정도 최대
STRESS_HR_REF_BPM=20        # 평상시보다 +20bpm → 심박 상승 정도 최대
STRESS_MSSD_REF=0.05        # 1분간 1초 평균 MSSD 0.05 → 기복 정도 최대
STRESS_WINDOW_SEC=10
STRESS_INSTAB_WINDOW_SEC=60
STRESS_MIN_FACE_RATIO=0.5
RPPG_DIAG_EVERY_SEC=30      # 이 간격마다 logs/rppg_diag_*/에 색 신호·주파수 그래프 저장 (0이면 끔)
FACE_BASELINE_SEC=60        # 처음 이 시간 동안 무표정 기준선을 잡음 (편한 얼굴로 화면 보기)
FACE_MODEL=compare          # off / compare(모델 결과는 기록만) / use(모델로 스트레스 계산). pip install hsemotion-onnx 필요
FACE_MODEL_EVERY=3          # 몇 프레임마다 모델 실행
LIVE_PORT=8765              # 웹페이지 '실시간 모니터링'이 읽는 상태 통로 (0이면 끔)
EMOTION_LOG_EVERY_SEC=60    # 이 간격(초)마다 감정 기록을 백엔드에 저장 (0이면 끔)
